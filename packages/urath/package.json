{
  "name": "@urath/threejs",
  "version": "0.1.0",
  "description": "Bounded voxel surface meshing and scalar volume rendering for Three.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "dist",
    "src",
    "wasm",
    "scripts/check-package.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LachyFS/urath.git",
    "directory": "packages/urath"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepack": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.172.0 <0.173.0"
  },
  "devDependencies": {
    "three": "^0.172.0",
    "@types/three": "^0.172.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
